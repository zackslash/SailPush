[Unit]
Description=SailPush Background Service
# Session bus is provided by user-session.target (no Requires=dbus.service — that would hit the system bus)
After=pre-user-session.target

[Service]
Type=simple
ExecStart=/usr/bin/invoker --type=generic /usr/bin/sailpush --daemon
# always: recover from clean Quit() during RPM upgrade even when no UI is running
Restart=always
RestartSec=5
Environment=QT_LOGGING_RULES=com.zackslash.sailpush.*=true

[Install]
WantedBy=user-session.target
